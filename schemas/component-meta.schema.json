{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cadenceclinical.app/schema/component-meta.json",
  "title": "Cadence component metadata",
  "description": "Describes one component: what it is and what grade it holds. The grade levels are provisional until the grading matrix is agreed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "title", "description", "category", "grade"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "category": { "enum": ["primitive", "clinical"] },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "enum": ["draft", "tested", "clinician-verified", "in-production"] },
        "version": {
          "type": "string",
          "description": "The package version the grade was assessed against. Required above tested."
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Repo-relative paths to review records. Required above tested."
        }
      }
    }
  }
}
