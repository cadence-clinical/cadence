        "patterns-date-picker--a-date-that-does-not-exist",
        "patterns-date-picker--typed-in-words",
        "patterns-date-picker--chosen-from-the-calendar",
        "patterns-date-picker--down-opens-the-calendar",
        "patterns-date-picker--a-date-and-a-time",
        "patterns-date-picker--a-time-on-its-own"
      ]
    },
    "Form": {
      "skip": [
        "patterns-form--a-summary-when-it-is-sent",
        "patterns-form--a-link-moves-focus-to-its-field",
        "patterns-form--a-link-points-at-its-control",
        "patterns-form--a-fixed-problem-leaves-the-list",
        "patterns-form--sent-again-focus-returns",
        "patterns-form--sent-when-every-field-is-right",
        "patterns-form--your-own-title",
        "patterns-form--without-a-summary",
        "patterns-form--errors-from-a-server",
        "patterns-form--a-server-error-clears-when-the-value-changes",
        "patterns-form--errors-that-arrive-late-leave-focus-alone",
        "patterns-form--with-a-form-library",
