    },
    "ListDetail": {
      "skip": ["layouts-list-and-detail--choosing-opens-it"]
    },
    "Calendar": {
      "skip": ["patterns-calendar--a-chosen-day", "patterns-calendar--with-month-and-year-menus"]
    },
    "DatePicker": {
      "skip": [
        "patterns-date-picker--typed-in-the-locales-order",
