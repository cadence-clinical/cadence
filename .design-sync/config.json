    "Toast": {
      "cardMode": "single",
      "primaryStory": "Default",
      "skip": [
        "patterns-toast--announced-when-it-appears",
        "patterns-toast--each-type-has-its-own-mark",
        "patterns-toast--an-urgent-toast",
        "patterns-toast--with-an-action",
        "patterns-toast--f-6-reaches-the-toasts",
        "patterns-toast--follows-comfortable-density",
