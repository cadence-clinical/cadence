        "patterns-vitals-chart--hover-a-value"
      ]
    },
    "TrackChart": {
      "skip": ["composites-track-chart--hover-a-mark", "composites-track-chart--pointer-time"]
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}
