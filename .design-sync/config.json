    "DataTable": {
      "skip": [
        "patterns-datatable--sorts-from-the-heading",
        "patterns-datatable--selects-rows",
        "patterns-datatable--moves-between-pages",
        "patterns-datatable--hides-a-column",
        "patterns-datatable--with-row-actions"
