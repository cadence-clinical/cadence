{
  "projectId": "6eafad55-cf60-4059-b5a1-a0c35ffd9efb",
  "shape": "storybook",
  "pkg": "@cadence-clinical/ui",
  "globalName": "Cadence",
  "storybookConfigDir": "apps/storybook/.storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "buildCmd": "pnpm turbo run build --filter=./packages/* && node .design-sync/compile-css.mjs",
  "extraEntries": [
    "./dist/calendar.mjs",
    "./dist/data-table.mjs",
    "./dist/date-picker.mjs",
    "../clinical/dist/index.mjs",
    "../core/dist/index.mjs",
    "../fhir/dist/index.mjs"
  ],
  "libOverrides": {
    "dts.mjs": "tsdown emits .d.mts and the packages declare types only under exports[\".\"].types; the bundled dts.mjs reads only .d.ts and top-level types",
    "preview-gen-storybook.mjs": "story and meta globals reach the story context and ride on the composed story as __dsGlobals, so the theme decorator can apply them",
    "source-storybook.mjs": "the decorator bundle loads .css as empty (preview.css imports tailwindcss) and applies each story's __dsGlobals over the initial globals"
  },
  "titleMap": {
    "Applicationshell": "AppShell",
    "Datepicker": "DatePicker",
    "Listanddetail": "ListDetail",
    "Radiogroup": "RadioGroup",
    "Trackchart": "TrackChart",
    "Typeset": null,
    "Medicationcard": "MedicationCard",
    "Observationtable": "ObservationTable",
    "Vitalschart": "VitalsChart"
  },
  "storyImports": {
    "shim": ["/packages/ui/src/components/", "/packages/clinical/src/components/"]
  },
  "docsDir": "../../apps/site/content/docs/components",
  "docsMap": {
    "Badge": "../../apps/site/content/docs/components/badge/index.mdx",
    "Button": "../../apps/site/content/docs/components/button/index.mdx",
    "Input": "../../apps/site/content/docs/components/input/index.mdx",
    "MedicationCard": "../../apps/site/content/docs/components/medication-card/index.mdx",
    "ObservationTable": "../../apps/site/content/docs/components/observation-table/index.mdx",
    "TrackChart": "../../apps/site/content/docs/components/track-chart/index.mdx",
    "VitalsChart": "../../apps/site/content/docs/components/vitals-chart/index.mdx"
  },
  "cssEntry": "./dist/design-sync.css",
  "extraFonts": [
    "../../apps/storybook/node_modules/@fontsource-variable/geist/wght.css",
    "../../apps/storybook/node_modules/@fontsource-variable/geist-mono/wght.css",
    "../../apps/storybook/node_modules/@fontsource-variable/work-sans/wght.css",
    "../../apps/storybook/node_modules/@fontsource-variable/figtree/wght.css",
    "../../apps/storybook/node_modules/@fontsource-variable/source-sans-3/wght.css"
  ],
  "overrides": {
    "AlertDialog": {
      "cardMode": "single",
      "primaryStory": "Open",
      "skip": [
        "composites-alertdialog--opens-on-the-safe-answer",
        "composites-alertdialog--escape-cancels",
        "composites-alertdialog--enter-keeps-the-medicine"
      ]
    },
    "Dialog": {
      "cardMode": "single",
      "primaryStory": "Open",
      "skip": [
        "composites-dialog--opens-named-and-described",
        "composites-dialog--closes-from-the-corner",
        "composites-dialog--stays-open-on-a-press-outside"
      ]
    },
    "Drawer": {
      "cardMode": "single",
      "primaryStory": "Open",
      "skip": [
        "composites-drawer--cancel-closes",
        "composites-drawer--pressing-the-scrim-closes-it",
        "composites-drawer--tall-content-scrolls"
      ]
    },
    "DropdownMenu": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "Popover": {
      "cardMode": "single",
      "primaryStory": "Open",
      "skip": [
        "composites-popover--opens-named-and-described",
        "composites-popover--opens-at-once-from-the-keyboard"
      ]
    },
    "Sheet": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "Select": {
      "cardMode": "single",
      "primaryStory": "Default"
    },
    "Tooltip": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "AppShell": {
      "cardMode": "single",
      "primaryStory": "Default",
      "skip": [
        "layouts-application-shell--skips-to-the-content",
        "layouts-application-shell--on-a-phone"
