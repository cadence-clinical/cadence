{
  "name": "@cadence-clinical/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook for Cadence Clinical: the component workshop and the browser test runner.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "storybook build --stats-json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:browser": "vitest run",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@cadence-clinical/tokens": "workspace:*",
    "@cadence-clinical/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cadence-clinical/config": "workspace:*",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-table": "^9.2.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "catalog:",
    "chromatic": "^18.8.0",
    "eslint": "catalog:",
    "eslint-plugin-storybook": "^10.6.0",
    "playwright": "catalog:",
    "react-day-picker": "^10.0.1",
    "storybook": "^10.6.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vitest": "catalog:"
  }
}
