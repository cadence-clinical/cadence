{
  "name": "@cadence-clinical/core",
  "version": "0.0.0",
  "description": "Framework-free foundations for Cadence Clinical: the Region contract, view-model types and the component grade schema.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cadence-clinical/cadence.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cadence-clinical/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
