{
  "name": "@cadence-clinical/tokens",
  "version": "0.0.0",
  "description": "Design tokens for Cadence Clinical: modes, density, curated accents, fixed clinical status colours and the accent validator.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cadence-clinical/cadence.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./theme.css": "./dist/theme.css",
    "./typeset.css": "./dist/typeset.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "culori": "^4.0.2"
  },
  "devDependencies": {
    "@cadence-clinical/config": "workspace:*",
    "@types/culori": "^4.0.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
